APP_NAME=Tu Comité API
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/tu_comite?charset=utf8mb4
PUBLIC_SITE_URL=https://tucomite.cl
# SMTP for Soporte replies to web Mensaje tickets (required to email visitors):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@tucomite.cl
# SMTP_USE_TLS=true
# Production (Firebase + api.tucomite.cl cross-origin cookies):
# SESSION_SAME_SITE=none
# SESSION_HTTPS_ONLY=true
# CORS_ORIGINS=["https://tucomite.cl","https://www.tucomite.cl","https://admin.tucomite.cl","https://tucomite-admin.web.app","https://tucomite-admin.firebaseapp.com","https://tucomite-frontend.web.app","https://tucomite-frontend.firebaseapp.com"]
